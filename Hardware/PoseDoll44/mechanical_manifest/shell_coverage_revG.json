  "principle_zh": "形状稳定的独立刚性节段可以包壳；会因关节运动改变外形的区域保持机械骨架裸露。",
  "rules": {
    "soft_skin_required": false,
    "joint_boots_required": false,
    "floating_shoulder_caps_required": false,
    "shell_must_not_bridge_mechanical_axes": true,
